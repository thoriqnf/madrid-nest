generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 1-to-1: User <-> Profile
// ============================================================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  profile     Profile?
  courses     Course[]     // 1-to-many: User authors many courses
  enrollments Enrollment[] // M2M explicit: User enrolls in many courses

  @@map("users")
}

model Profile {
  id        Int     @id @default(autoincrement())
  bio       String?
  avatarUrl String? @map("avatar_url")
  phone     String?

  // 1-to-1 FK — @unique enforces strict one-to-one
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============================================================
// 1-to-many: User -> Course, Course -> Lesson
// ============================================================
model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // FK to author (User) — cascade delete when author is deleted
  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Relations
  lessons     Lesson[]     // 1-to-many: Course has many lessons
  enrollments Enrollment[] // M2M explicit: many users enroll in this course

  @@map("courses")
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // FK to Course — cascade delete when course is deleted
  courseId Int    @map("course_id")
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}



// ============================================================
// Many-to-Many (explicit): User <-> Course via Enrollment
// Manual join table with extra fields (enrolledAt, progress, completedAt)
// ============================================================
model Enrollment {
  id          Int       @id @default(autoincrement())
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")
  progress    Int       @default(0) // percentage 0-100

  // FK to User — cascade delete when user is deleted
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FK to Course — cascade delete when course is deleted
  courseId Int    @map("course_id")
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Prevent duplicate enrollments
  @@unique([userId, courseId])
  @@map("enrollments")
}
