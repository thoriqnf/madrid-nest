generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================
enum Role {
  USER
  ADMIN
}

// ============================================================
// Model: User
// ============================================================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  hashedRefreshToken String? @map("hashed_refresh_token")

  // Relation 1.1: Add 1-to-1 relationship with the Profile model
  profile   Profile?

  // Relation 1.2: Add 1-to-many relationship with the Course model (authoring)
  courses   Course[]

  // Relation 1.4: Add many-to-many relationship with the Course model via Enrollment
  enrollments Enrollment[]

  @@map("users")
}

// Relation 1.1: Create the Profile model here with a 1-to-1 relation to User
model Profile {
  id        Int     @id @default(autoincrement())
  bio       String?
  avatarUrl String? @map("avatar_url")
  phone     String?
  userId    Int     @unique @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============================================================
// Model: Course
// ============================================================
model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relation 1.2: Establish 1-to-many relationship side mapping to User (authorId)
  authorId    Int      @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Relation 1.3: Establish 1-to-many relationship with Lesson model
  lessons     Lesson[]

  // Relation 1.4: Add many-to-many relationship with User model via Enrollment
  enrollments Enrollment[]

  @@map("courses")
}

// Relation 1.3: Create the Lesson model here with a 1-to-many relation to Course
model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  order     Int
  courseId  Int      @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

// Relation 1.4: Create the Enrollment model here for Explicit M2M between User and Course
model Enrollment {
  id         Int      @id @default(autoincrement())
  progress   Int      @default(0)
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int      @map("course_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  @@unique([userId, courseId])
  @@map("enrollments")
}
